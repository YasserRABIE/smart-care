# --- Database (matches docker/docker-compose.dev.yml) ---
DATABASE_URI=postgres://smartcare:smartcare@localhost:5433/smartcare

# --- Payload ---
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend). Optional locally, required in production ---
RESEND_API_KEY=
CONTACT_FALLBACK_EMAIL=

# --- Cloudflare Turnstile. Optional locally, required in production ---
# Test keys that always pass: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local seed admin (used by the seed script, Phase 3) ---
SEED_ADMIN_EMAIL=admin@smartcare.test
SEED_ADMIN_PASSWORD=
