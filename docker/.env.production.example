# Copy to /opt/smart-care/.env on the VPS and `chmod 600` it. Never commit the real file.
# Generate random values with: openssl rand -hex 32

# --- Compose ---
# GitHub user/org that owns the image, lowercase (ghcr.io/<owner>/smart-care-web)
GHCR_OWNER=
# Image tag to run; defaults to latest. Set to a commit SHA to roll back.
# TAG=
POSTGRES_PASSWORD=

# --- App (validated by apps/web/src/lib/env.ts) ---
# Same password as POSTGRES_PASSWORD; host is the compose service name.
DATABASE_URI=postgres://smartcare:<POSTGRES_PASSWORD>@postgres:5432/smartcare
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://smartcareco.com
